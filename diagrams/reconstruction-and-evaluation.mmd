flowchart TD
    subgraph INFERENCE_OUTPUT ["1. Predicted Patch Mask Arrays"]
        PATCHES["N Predicted Patches<br/>(128x128 Arrays)"]
        THRESHOLD["Binarization Gate (Predict.py)<br/>(Logit > 0 -> 1.0, else 0.0)"]
    end

    subgraph REVERSE_STITCH ["2. 2D Coordinate Grid Assembly"]
        CANVAS["Zero-Initialized Canvas<br/>(512x512 np.zeros uint8)"]
        TILE_LOOP["Reverse Grid Projection Loop<br/>(reconstruct_image, Stride 128)"]
        PASTE["Spatial Assignment:<br/>canvas[i:i+128, j:j+128] = patch"]
        SLICE_2D["Assembled 2D Slice Mask<br/>(512x512 Binary Image)"]
    end

    subgraph VOLUMETRIC_STACK ["3. Axial Volumetric Stacking"]
        COLLECT["Collect Sequential Slices<br/>(image_slices list)"]
        STACK["NumPy Volumetric Stacking<br/>np.stack(image_slices, axis=-1)"]
        RAW_3D["3D Voxel Array<br/>(512 x 512 x Z)"]
    end

    subgraph NIFTI_PACKAGING ["4. Coordinate-Preserving Export"]
        AFFINE["Native Affine Matrix Preservation<br/>(affine = self.orignal_affine)"]
        HEADER["Native Header Metadata<br/>(header = self.orignal_header)"]
        NII_OBJ["nibabel.Nifti1Image Instance<br/>nib.save(recon3d.nii)"]
    end

    subgraph VALIDATION_METRICS ["5. Quantitative Clinical Benchmarking"]
        DICE["Dice Similarity Coefficient (DSC):<br/>2 * |P ∩ G| / (|P| + |G|)<br/>Result: 88.46% (Empirical Test Result)"]
        IOU["Jaccard Index (IoU):<br/>|P ∩ G| / |P ∪ G|<br/>Result: 83.26% (Empirical Test Result)"]
        BENCH["Boundary F-score: 91.01%<br/>Sensitivity: 93.81%<br/>Test Set: 5 Cases / 3,418 Slices"]
    end

    PATCHES --> THRESHOLD
    THRESHOLD --> CANVAS
    CANVAS --> TILE_LOOP
    TILE_LOOP --> PASTE
    PASTE --> SLICE_2D
    SLICE_2D --> COLLECT
    COLLECT --> STACK
    STACK --> RAW_3D
    RAW_3D --> NII_OBJ
    AFFINE -.->|"Preserve Origin & Orientation"| NII_OBJ
    HEADER -.->|"Preserve Millimeter Spacing"| NII_OBJ

    NII_OBJ --> DICE
    NII_OBJ --> IOU
    NII_OBJ --> BENCH
