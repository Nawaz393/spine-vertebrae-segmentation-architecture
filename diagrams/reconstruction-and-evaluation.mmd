flowchart TD
    subgraph INFERENCE_OUTPUT ["1. Predicted Patch Probability Maps"]
        PATCHES["N Predicted Patches<br/>(128x128 Float Probability Maps)"]
        THRESHOLD["Binarization Gate<br/>(Probability >= 0.5 -> 1.0, else 0.0)"]
    end

    subgraph REVERSE_STITCH ["2. 2D Coordinate Grid Assembly"]
        CANVAS["Zero-Initialized Canvas<br/>(512x512 np.zeros uint8)"]
        TILE_LOOP["Reverse Grid Projection Loop<br/>(Step size: Stride dx, dy)"]
        PASTE["Spatial Assignment:<br/>canvas[y:y+128, x:x+128] = patch"]
        SLICE_2D["Assembled 2D Slice Mask<br/>(512x512 Binary Image)"]
    end

    subgraph VOLUMETRIC_STACK ["3. Axial Volumetric Stacking"]
        COLLECT["Collect All Z Slices<br/>(image_slices list)"]
        STACK["NumPy Volumetric Stacking<br/>np.stack(image_slices, axis=-1)"]
        RAW_3D["3D Voxel Array<br/>(512 x 512 x Z)"]
    end

    subgraph POST_PROCESSING ["4. 3D Morphological Filtering"]
        OPENING["Morphological Opening<br/>(scipy.ndimage.binary_opening, 5x5 kernel)"]
        DILATION["Controlled Dilation<br/>(Restore Trabecular Margins)"]
        HOLE_FILL["3D Hole Closing<br/>(scipy.ndimage.binary_fill_holes)"]
    end

    subgraph NIFTI_PACKAGING ["5. Coordinate-Preserving Export"]
        AFFINE["Native Affine Matrix Preservation<br/>(affine = original_affine)"]
        HEADER["Native Header Metadata<br/>(header = original_header, Spacing sx, sy, sz)"]
        NII_OBJ["nibabel.Nifti1Image Instance<br/>nib.save(recon3d.nii)"]
    end

    subgraph VALIDATION_METRICS ["6. Quantitative Clinical Benchmarking"]
        DICE["Dice Similarity Coefficient (DSC):<br/>2 * |P ∩ G| / (|P| + |G|)<br/>Result: 99.14% Mean (99.73% Peak)"]
        IOU["Jaccard Index (IoU):<br/>|P ∩ G| / |P ∪ G|<br/>Result: 98.30% Mean (99.46% Peak)"]
    end

    PATCHES --> THRESHOLD
    THRESHOLD --> CANVAS
    CANVAS --> TILE_LOOP
    TILE_LOOP --> PASTE
    PASTE --> SLICE_2D
    SLICE_2D --> COLLECT
    COLLECT --> STACK
    STACK --> RAW_3D
    RAW_3D --> OPENING
    OPENING --> DILATION
    DILATION --> HOLE_FILL
    HOLE_FILL --> NII_OBJ
    AFFINE -.->|"Preserve Origin & Orientation"| NII_OBJ
    HEADER -.->|"Preserve Millimeter Spacing"| NII_OBJ

    HOLE_FILL --> DICE
    HOLE_FILL --> IOU
