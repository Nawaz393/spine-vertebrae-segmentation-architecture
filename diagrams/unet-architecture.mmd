flowchart TD
    subgraph INPUT ["Input Layer"]
        IN["Normalized 2D Patch<br/>(1 x 128 x 128 Float Tensor)"]
    end

    subgraph ENCODER ["Contracting Path (Feature Extraction)"]
        E1["Enc Block 1:<br/>2x [Conv 3x3 (64) + BN + ReLU]<br/>Output: 64 x 128 x 128"]
        P1["MaxPool 2x2 (Stride 2)<br/>Output: 64 x 64 x 64"]
        
        E2["Enc Block 2:<br/>2x [Conv 3x3 (128) + BN + ReLU]<br/>Output: 128 x 64 x 64"]
        P2["MaxPool 2x2 (Stride 2)<br/>Output: 128 x 32 x 32"]
        
        E3["Enc Block 3:<br/>2x [Conv 3x3 (256) + BN + ReLU]<br/>Output: 256 x 32 x 32"]
        P3["MaxPool 2x2 (Stride 2)<br/>Output: 256 x 16 x 16"]
        
        E4["Enc Block 4:<br/>2x [Conv 3x3 (512) + BN + ReLU]<br/>Output: 512 x 16 x 16"]
        P4["MaxPool 2x2 (Stride 2)<br/>Output: 512 x 8 x 8"]
    end

    subgraph BOTTLENECK ["Latent Bottleneck Bridge"]
        B["Bottleneck Block:<br/>2x [Conv 3x3 (1024) + BN + ReLU]<br/>Output: 1024 x 8 x 8"]
    end

    subgraph DECODER ["Expansive Path (Spatial Synthesis)"]
        UP4["ConvTranspose2d 2x2 (512)<br/>Output: 512 x 16 x 16"]
        CAT4["Concat with Skip 4<br/>Output: 1024 x 16 x 16"]
        D4["Dec Block 4:<br/>2x [Conv 3x3 (512) + BN + ReLU]<br/>Output: 512 x 16 x 16"]

        UP3["ConvTranspose2d 2x2 (256)<br/>Output: 256 x 32 x 32"]
        CAT3["Concat with Skip 3<br/>Output: 512 x 32 x 32"]
        D3["Dec Block 3:<br/>2x [Conv 3x3 (256) + BN + ReLU]<br/>Output: 256 x 32 x 32"]

        UP2["ConvTranspose2d 2x2 (128)<br/>Output: 128 x 64 x 64"]
        CAT2["Concat with Skip 2<br/>Output: 256 x 64 x 64"]
        D2["Dec Block 2:<br/>2x [Conv 3x3 (128) + BN + ReLU]<br/>Output: 128 x 64 x 64"]

        UP1["ConvTranspose2d 2x2 (64)<br/>Output: 64 x 128 x 128"]
        CAT1["Concat with Skip 1<br/>Output: 128 x 128 x 128"]
        D1["Dec Block 1:<br/>2x [Conv 3x3 (64) + BN + ReLU]<br/>Output: 64 x 128 x 128"]
    end

    subgraph OUTPUT_HEAD ["Classification Head & Serialization"]
        CONV1X1["1x1 Convolution (1 Channel)<br/>Output: 1 x 128 x 128"]
        SIGMOID["Sigmoid Activation / Threshold >= 0.5<br/>Binary Vertebrae Mask"]
        JIT["TorchScript JIT Serialization<br/>Single_SpineSegmentationv8.2_cpu.pth"]
    end

    IN --> E1
    E1 --> P1
    P1 --> E2
    E2 --> P2
    P2 --> E3
    E3 --> P3
    P3 --> E4
    E4 --> P4
    P4 --> B

    B --> UP4
    E4 -.->|"Skip Connection 4"| CAT4
    UP4 --> CAT4
    CAT4 --> D4

    D4 --> UP3
    E3 -.->|"Skip Connection 3"| CAT3
    UP3 --> CAT3
    CAT3 --> D3

    D3 --> UP2
    E2 -.->|"Skip Connection 2"| CAT2
    UP2 --> CAT2
    CAT2 --> D2

    D2 --> UP1
    E1 -.->|"Skip Connection 1"| CAT1
    UP1 --> CAT1
    CAT1 --> D1

    D1 --> CONV1X1
    CONV1X1 --> SIGMOID
    SIGMOID --> JIT
